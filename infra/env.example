HOST=127.0.0.1
PORT=4310
DATABASE_URL=postgres://framepool:CHANGE_ME@127.0.0.1:55432/framepool
# Built-in default for local setup only. For other hosts use a unique 32+ character key.
ADMIN_API_KEY=xiaoche144
VIEWER_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_OR_MORE_CHARACTERS
GENERATION_ENABLED=false
# Relative to the workspace; these refer to the preserved P0 account, never a copy.
LIBTV_BINARY=.local/libtv-p0/bin/libtv-win-x64/libtv.exe
LIBTV_ACCOUNT_ROOT=.local/libtv-p0/accounts
